# =====================================================================
# 知归（KnowWhere）环境变量配置示例
# ---------------------------------------------------------------------
# 使用说明：
# 1. 复制此文件为 .env：Copy-Item .env.example .env
# 2. 填写所有标注“必填”的变量，按需填写腾讯云可选变量
# 3. .env 包含真实密钥，已被 Git 和 Docker 构建上下文忽略
#
# 配置优先级：进程环境变量 > --env-file 指定文件 > 根目录 .env
# =====================================================================

# #####################################################################
# A. 运行时与数据库
# #####################################################################

# 用户自行准备的 PostgreSQL 连接地址，Docker Compose 不会创建数据库。
# 格式为 用户名:URL编码后的密码@地址:端口/数据库名；密码含特殊字符时必须先做 URL 编码。
KW_DATABASE_URL=postgresql+psycopg://replace_with_user:replace_with_url_encoded_password@replace_with_postgres_host:5432/knowwhere

# #####################################################################
# B. 飞书机器人（必填）
# #####################################################################

# 飞书自建应用 App ID，通常以 cli_ 开头。
KW_FEISHU_APP_ID=cli_replace_with_app_id

# 飞书自建应用 App Secret。
KW_FEISHU_APP_SECRET=replace_with_app_secret

# #####################################################################
# C. OpenAI 兼容 LLM（必填）
# #####################################################################

# OpenAI 兼容接口 API Key。
KW_LLM_API_KEY=replace_with_llm_api_key

# OpenAI 兼容 API 根地址，必须包含 http(s) scheme。
KW_LLM_BASE_URL=https://replace-with-provider.example/v1

# 供应商实际可用的模型标识，不在代码中写死。
KW_LLM_MODEL=replace_with_model_id

# 单次生成读取超时秒数，默认 180，必须大于 0 且不超过 600。
KW_LLM_TIMEOUT_SECONDS=180

# 非标准思考模式扩展：默认 disabled；需要思考模式时设为 enabled，不支持该字段时留空。
KW_LLM_THINKING_MODE=disabled

# #####################################################################
# D. 腾讯云 ASR 与 COS（视频链路可选）
# #####################################################################

# 腾讯云账号 AppId。
KW_TENCENTCLOUD_APP_ID=

# 腾讯云 API SecretId；ASR 与 COS 首版复用同一最小权限凭据。
KW_TENCENTCLOUD_SECRET_ID=

# 腾讯云 API SecretKey。
KW_TENCENTCLOUD_SECRET_KEY=

# COS Bucket 地域，例如 ap-shanghai。
KW_COS_REGION=

# 完整 Bucket 名称，必须包含 AppId 后缀。
KW_COS_BUCKET=

# 知归临时对象专用前缀。
KW_COS_PREFIX=knowwhere-temp/
