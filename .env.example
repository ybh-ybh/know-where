# ═════════════════════════════════════════════════════════════════════════════
# 知归（KnowWhere）- 环境变量配置模板
#
# 用法：
#   Copy-Item .env.example .env
#   # 编辑 .env，把 REPLACE_ME 换成你自己的值
#   uv sync --all-groups
#   uv run knowwhere migrate-and-health
#
# 配置优先级：进程环境变量 > --env-file 指定文件 > 根目录 .env
# .env 包含真实密钥，已被 Git 和 Docker 构建上下文忽略。
# ═════════════════════════════════════════════════════════════════════════════

# ── 运行时与数据库（必填）───────────────────────────────────────────────────
# PostgreSQL 由用户自行准备，Docker Compose 不会创建数据库。
# 密码包含特殊字符时必须先做 URL 编码。
KW_DATABASE_URL=REPLACE_ME                  # 例：postgresql+psycopg://username:password@127.0.0.1:5432/knowwhere

# ── 飞书机器人（必填）───────────────────────────────────────────────────────
# 飞书自建应用的凭据，可在开放平台“凭证与基础信息”中查看。
KW_FEISHU_APP_ID=REPLACE_ME                 # 例：cli_xxxxxxxxxxxxxxxx
KW_FEISHU_APP_SECRET=REPLACE_ME             # 例：xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── OpenAI 兼容文本模型（必填）──────────────────────────────────────────────
# 正文分析使用的模型；BASE_URL 必须包含 http:// 或 https://。
KW_LLM_API_KEY=REPLACE_ME                   # 例：sk-xxxxxxxx
KW_LLM_BASE_URL=REPLACE_ME                  # 例：https://api.deepseek.com/v1
KW_LLM_MODEL=REPLACE_ME                     # 例：deepseek-chat
KW_LLM_TIMEOUT_SECONDS=180                  # 单次生成读取超时秒数，范围：0～600（不含 0）
KW_LLM_THINKING_MODE=disabled               # disabled | enabled；供应商不支持时可留空

# ── OpenAI 兼容视觉模型（抖音图文链路可选）──────────────────────────────────
# 处理抖音图文时，取消下面三行注释并替换 REPLACE_ME；三项必须同时配置。
# KW_VISION_API_KEY=REPLACE_ME               # 例：xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# KW_VISION_BASE_URL=REPLACE_ME              # 例：https://open.bigmodel.cn/api/paas/v4
# KW_VISION_MODEL=REPLACE_ME                 # 例：glm-4.6v
KW_VISION_TIMEOUT_SECONDS=300                # 多图请求超时秒数
KW_VISION_THINKING_MODE=disabled             # disabled | enabled；供应商不支持时可留空

# ── 腾讯云 ASR 与 COS（抖音/B站视频链路可选）────────────────────────────────
# 处理视频时，取消下面五行注释并替换 REPLACE_ME；五项必须同时配置。
# ASR 与 COS 首版复用同一组最小权限凭据。
# KW_TENCENTCLOUD_APP_ID=REPLACE_ME           # 例：1250000000
# KW_TENCENTCLOUD_SECRET_ID=REPLACE_ME        # 例：AKIDxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# KW_TENCENTCLOUD_SECRET_KEY=REPLACE_ME       # 例：xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# KW_COS_REGION=REPLACE_ME                    # 例：ap-shanghai
# KW_COS_BUCKET=REPLACE_ME                    # 例：knowwhere-temp-1250000000

# 知归临时对象专用前缀。
KW_COS_PREFIX=knowwhere-temp/

# 私有对象短时下载地址有效期秒数，默认 3600。
KW_COS_PRESIGNED_URL_TTL_SECONDS=3600

# 腾讯云录音文件识别引擎。
KW_TENCENT_ASR_ENGINE_MODEL_TYPE=16k_zh

# 轮询间隔与单任务最大等待秒数。
KW_TENCENT_ASR_POLL_INTERVAL_SECONDS=3
KW_TENCENT_ASR_MAX_WAIT_SECONDS=1800

# ── 平台媒体处理限制（默认可直接使用）──────────────────────────────────────
# 页面与 CDN 请求超时秒数。
KW_DOUYIN_REQUEST_TIMEOUT_SECONDS=60

# 单张图片、单个视频和单作品图片数上限。
KW_DOUYIN_MAX_IMAGE_BYTES=20971520
KW_DOUYIN_MAX_VIDEO_BYTES=4294967296
KW_DOUYIN_MAX_IMAGES=30

# B站公开接口/CDN 请求超时和单条 DASH 音频大小上限。
KW_BILIBILI_REQUEST_TIMEOUT_SECONDS=60
KW_BILIBILI_MAX_AUDIO_BYTES=2147483648

# FFmpeg 可执行文件名或绝对路径；容器镜像已内置 ffmpeg。
KW_FFMPEG_PATH=ffmpeg
